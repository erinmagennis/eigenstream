# Server Configuration
PORT=8000
RTMP_PORT=1935

# RTMP Stream Settings
STREAM_KEY=eigenstream

# Storage (use absolute paths or Docker volumes in production)
VIDEO_STORAGE_PATH=./data/videos
ANALYSIS_STORAGE_PATH=./data/analysis
HLS_PATH=./data/hls

# Attestation (TEE signing key - generated on first run)
KEYSTORE_PATH=~/.eigenstream/keystore.json
ATTESTATION_PRIVATE_KEY=

# Base Blockchain (for later)
BASE_RPC_URL=https://mainnet.base.org
BASE_CONTRACT_ADDRESS=

# Dashboard
DASHBOARD_URL=http://localhost:3000

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-dashboard.vercel.app
